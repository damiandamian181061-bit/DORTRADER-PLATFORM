{
  "$defs": {
    "QualityFlag": {
      "enum": [
        "no_bid",
        "no_ask",
        "crossed",
        "locked",
        "wide_spread",
        "off_tick",
        "iv_missing",
        "stale_exchange_ts",
        "duplicate",
        "unknown_instrument",
        "stale_no_update",
        "outside_price_band",
        "underlying_stale",
        "sequence_gap",
        "clock_drift"
      ],
      "title": "QualityFlag",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One observation of an option's top of book and mark, as received.",
  "properties": {
    "ask_price": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ask Price"
    },
    "bid_price": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Bid Price"
    },
    "channel": {
      "title": "Channel",
      "type": "string"
    },
    "connection_epoch": {
      "default": 0,
      "title": "Connection Epoch",
      "type": "integer"
    },
    "exchange_ts": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Exchange Ts"
    },
    "flags": {
      "default": [],
      "items": {
        "$ref": "#/$defs/QualityFlag"
      },
      "title": "Flags",
      "type": "array"
    },
    "instrument_name": {
      "title": "Instrument Name",
      "type": "string"
    },
    "interest_rate": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Interest Rate"
    },
    "last_price": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Last Price"
    },
    "mark_iv": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Mark Iv"
    },
    "mark_price": {
      "minimum": 0,
      "title": "Mark Price",
      "type": "number"
    },
    "open_interest": {
      "minimum": 0,
      "title": "Open Interest",
      "type": "number"
    },
    "raw_sha256": {
      "title": "Raw Sha256",
      "type": "string"
    },
    "received_at": {
      "format": "date-time",
      "title": "Received At",
      "type": "string"
    },
    "source": {
      "title": "Source",
      "type": "string"
    },
    "underlying_index": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Underlying Index"
    },
    "underlying_price": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Underlying Price"
    },
    "volume": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Volume"
    }
  },
  "required": [
    "instrument_name",
    "source",
    "channel",
    "received_at",
    "exchange_ts",
    "bid_price",
    "ask_price",
    "mark_price",
    "mark_iv",
    "underlying_price",
    "underlying_index",
    "interest_rate",
    "open_interest",
    "volume",
    "last_price",
    "raw_sha256"
  ],
  "title": "OptionQuote",
  "type": "object"
}
