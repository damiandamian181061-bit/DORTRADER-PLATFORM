{
  "$defs": {
    "TickStep": {
      "additionalProperties": false,
      "description": "Prices above `above_price` move in steps of `tick_size`.",
      "properties": {
        "above_price": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Above Price"
        },
        "tick_size": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Tick Size"
        }
      },
      "required": [
        "above_price",
        "tick_size"
      ],
      "title": "TickStep",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "base_currency": {
      "enum": [
        "BTC",
        "USDC",
        "USD"
      ],
      "title": "Base Currency",
      "type": "string"
    },
    "contract_size": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Contract Size"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expiration": {
      "format": "date-time",
      "title": "Expiration",
      "type": "string"
    },
    "instrument_id": {
      "title": "Instrument Id",
      "type": "integer"
    },
    "instrument_type": {
      "enum": [
        "linear",
        "reversed"
      ],
      "title": "Instrument Type",
      "type": "string"
    },
    "is_active": {
      "title": "Is Active",
      "type": "boolean"
    },
    "maker_commission": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maker Commission"
    },
    "min_trade_amount": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Min Trade Amount"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "option_type": {
      "enum": [
        "call",
        "put"
      ],
      "title": "Option Type",
      "type": "string"
    },
    "price_index": {
      "title": "Price Index",
      "type": "string"
    },
    "quote_currency": {
      "enum": [
        "BTC",
        "USDC",
        "USD"
      ],
      "title": "Quote Currency",
      "type": "string"
    },
    "settlement_currency": {
      "enum": [
        "BTC",
        "USDC",
        "USD"
      ],
      "title": "Settlement Currency",
      "type": "string"
    },
    "state": {
      "enum": [
        "open",
        "settlement",
        "delivered",
        "inactive",
        "locked",
        "halted",
        "archivized"
      ],
      "title": "State",
      "type": "string"
    },
    "strike": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Strike"
    },
    "taker_commission": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Taker Commission"
    },
    "tick_size": {
      "anyOf": [
        {
          "exclusiveMinimum": 0.0,
          "type": "number"
        },
        {
          "type": "string"
        }
      ],
      "title": "Tick Size"
    },
    "tick_size_steps": {
      "default": [],
      "items": {
        "$ref": "#/$defs/TickStep"
      },
      "title": "Tick Size Steps",
      "type": "array"
    }
  },
  "required": [
    "instrument_id",
    "name",
    "base_currency",
    "quote_currency",
    "settlement_currency",
    "instrument_type",
    "option_type",
    "strike",
    "expiration",
    "created_at",
    "contract_size",
    "tick_size",
    "min_trade_amount",
    "state",
    "is_active",
    "price_index"
  ],
  "title": "Instrument",
  "type": "object"
}
